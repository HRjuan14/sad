# ✍️ TU TURNO — Escribe aquí debajo 4 entradas. Usa 01-ejemplo.ldif como modelo.
#
#   1. TÚ             uid = tu usuario     uidNumber/gidNumber 10001
#   2. Marta Torres   uid = mtorres        uidNumber/gidNumber 10003
#   3. El grupo rrhh      con Lucía y Marta
#   4. El grupo sistemas  contigo
#
# Recuerda:
#   - Una LÍNEA EN BLANCO entre cada entrada.
#   - Sin tildes ni eñes (Marta Torres, no Martá).
#   - Los grupos van en ou=groups. Mira en el enunciado cómo es un grupo.
#   - En "member" va el DN COMPLETO de la persona, no solo su uid.

dn: uid=jherrador,ou=people,dc=securecorp,dc=local
objectClass: inetOrgPerson
objectClass: posixAccount
uid: jherrador
cn: Juan Herrador
sn: Herrador
mail: jherrador@securecorp.local
uidNumber: 10001
gidNumber: 10001
homeDirectory: /home/jherrador

dn: uid=mtorres,ou=people,dc=securecorp,dc=local
objectClass: inetOrgPerson
objectClass: posixAccount
uid: mtorres
cn: Marta Torres
sn: Torres
mail: mtorres@securecorp.local
uidNumber: 10003
gidNumber: 10003
homeDirectory: /home/mtorres

dn: cn=rrhh,ou=groups,dc=securecorp,dc=local
objectClass: groupOfNames
cn: rrhh
member: uid=lromero,ou=people,dc=securecorp,dc=local
member: uid=mtorres,ou=people,dc=securecorp,dc=local

dn: cn=sistemas,ou=groups,dc=securecorp,dc=local
objectClass: groupOfNames
