# ✍️ Le dice a slapd dónde están los certificados.
# Cambia cada ____ por la ruta COMPLETA del fichero en /etc/ldap/tls/
# Se aplica EN EL SERVIDOR con:   ldapmodify -Y EXTERNAL -H ldapi:/// -f /ldif/03-tls.ldif

dn: cn=config
changetype: modify
replace: olcTLSCACertificateFile
olcTLSCACertificateFile: ____ (el certificado de la CA)
-
replace: olcTLSCertificateFile
olcTLSCertificateFile: ____ (el certificado del servidor)
-
replace: olcTLSCertificateKeyFile
olcTLSCertificateKeyFile: ____ (la clave privada del servidor)
